{
  "openapi": "3.1.0",
  "info": {
    "title": "MuleWatch Scoring API",
    "version": "0.1.0"
  },
  "paths": {
    "/investigate/{alert_id}": {
      "post": {
        "summary": "Investigate Alert",
        "description": "Start an investigation with human-in-the-loop review.\n\nA successfully verified investigation pauses at\nAWAITING_REVIEW instead of completing automatically.",
        "operationId": "investigate_alert_investigate__alert_id__post",
        "parameters": [
          {
            "name": "alert_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Alert Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases": {
      "get": {
        "tags": [
          "Case Review"
        ],
        "summary": "List Cases",
        "operationId": "list_cases_cases_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "x-review-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Review-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CaseListItem"
                  },
                  "title": "Response List Cases Cases Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}": {
      "get": {
        "tags": [
          "Case Review"
        ],
        "summary": "Get Case",
        "operationId": "get_case_cases__case_id__get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          },
          {
            "name": "x-review-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Review-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/decision": {
      "post": {
        "tags": [
          "Case Review"
        ],
        "summary": "Decide Case",
        "operationId": "decide_case_cases__case_id__decision_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          },
          {
            "name": "x-review-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Review-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewDecision"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/cases/{case_id}/audit": {
      "get": {
        "tags": [
          "Case Audit"
        ],
        "summary": "Get Case Audit",
        "description": "Return the ordered audit history of a case.",
        "operationId": "get_case_audit_cases__case_id__audit_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          },
          {
            "name": "x-review-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Review-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/score": {
      "post": {
        "summary": "Score Account",
        "operationId": "score_account_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/score/batch": {
      "post": {
        "summary": "Score Batch",
        "operationId": "score_batch_score_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchScoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchScoreRequest": {
        "properties": {
          "account_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Account Ids"
          },
          "feature_date": {
            "type": "string",
            "format": "date",
            "title": "Feature Date"
          }
        },
        "type": "object",
        "required": [
          "account_ids",
          "feature_date"
        ],
        "title": "BatchScoreRequest"
      },
      "BatchScoreResponse": {
        "properties": {
          "scores": {
            "items": {
              "$ref": "#/components/schemas/BatchScoreResult"
            },
            "type": "array",
            "title": "Scores"
          }
        },
        "type": "object",
        "required": [
          "scores"
        ],
        "title": "BatchScoreResponse"
      },
      "BatchScoreResult": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "risk_score": {
            "type": "number",
            "title": "Risk Score"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "type": "array",
            "title": "Reasons"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "risk_score",
          "model_version",
          "reasons"
        ],
        "title": "BatchScoreResult"
      },
      "CaseListItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "alert_id": {
            "type": "integer",
            "title": "Alert Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "agent_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Action"
          },
          "final_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Action"
          },
          "reviewer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewer Id"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "agreement": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agreement"
          }
        },
        "type": "object",
        "required": [
          "id",
          "alert_id",
          "status",
          "summary",
          "agent_action",
          "final_action",
          "reviewer_id",
          "reviewed_at",
          "agreement"
        ],
        "title": "CaseListItem"
      },
      "CaseReport": {
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "risk_rating": {
            "$ref": "#/components/schemas/RiskRating"
          },
          "recommended_action": {
            "$ref": "#/components/schemas/RecommendedAction"
          },
          "findings": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "type": "array",
            "title": "Findings"
          },
          "typology_matches": {
            "items": {
              "$ref": "#/components/schemas/TypologyMatch"
            },
            "type": "array",
            "title": "Typology Matches"
          },
          "open_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Open Questions"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "summary",
          "risk_rating",
          "recommended_action",
          "findings",
          "typology_matches",
          "open_questions",
          "confidence"
        ],
        "title": "CaseReport"
      },
      "Finding": {
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1,
            "title": "Claim"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "required": [
          "claim",
          "evidence_ids"
        ],
        "title": "Finding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvestigationResponse": {
        "properties": {
          "case_id": {
            "type": "integer",
            "title": "Case Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "report": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseReport"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "status",
          "report"
        ],
        "title": "InvestigationResponse"
      },
      "Reason": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "shap_value": {
            "type": "number",
            "title": "Shap Value"
          }
        },
        "type": "object",
        "required": [
          "feature",
          "value",
          "shap_value"
        ],
        "title": "Reason"
      },
      "RecommendedAction": {
        "type": "string",
        "enum": [
          "CLOSE_NO_ACTION",
          "ENHANCED_MONITORING",
          "ESCALATE_TO_INVESTIGATOR"
        ],
        "title": "RecommendedAction"
      },
      "ReviewDecision": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "override",
              "escalate"
            ],
            "title": "Decision"
          },
          "reviewer_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Reviewer Id"
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Comment"
          },
          "final_action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecommendedAction"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "decision",
          "reviewer_id",
          "comment"
        ],
        "title": "ReviewDecision"
      },
      "RiskRating": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH"
        ],
        "title": "RiskRating"
      },
      "ScoreRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          }
        },
        "type": "object",
        "required": [
          "account_id"
        ],
        "title": "ScoreRequest"
      },
      "ScoreResponse": {
        "properties": {
          "risk_score": {
            "type": "number",
            "title": "Risk Score"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "type": "array",
            "title": "Reasons"
          }
        },
        "type": "object",
        "required": [
          "risk_score",
          "model_version",
          "reasons"
        ],
        "title": "ScoreResponse"
      },
      "TypologyMatch": {
        "properties": {
          "typology": {
            "type": "string",
            "minLength": 1,
            "title": "Typology"
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "title": "Explanation"
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "title": "Evidence Id"
          },
          "chunk_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Chunk Ids"
          }
        },
        "type": "object",
        "required": [
          "typology",
          "explanation",
          "evidence_id",
          "chunk_ids"
        ],
        "title": "TypologyMatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
